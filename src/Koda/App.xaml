<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Koda.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers"
    xmlns:controls="using:Koda.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <helpers:SecondsTextConverter x:Key="SecondsText" />
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Koda-rounder geometry: the 12/20/28 pattern. -->
            <CornerRadius x:Key="CoverRadius">12</CornerRadius>
            <CornerRadius x:Key="ThumbRadius">6</CornerRadius>

            <!-- Dense catalog rows: 56 tall, no hover inflation. -->
            <Style x:Key="CatalogRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="CardItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <!-- The same card metrics on a GridView: its container is a GridViewItem, and a style for
                 the wrong container type fails inside XAML when the first item is realized. -->
            <Style x:Key="CardGridItemStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Padding" Value="6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <!-- A song row: thumb, title over artist line, video chip, duration. -->
            <DataTemplate x:Key="SongRowTemplate">
                <Grid Height="56" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="{StaticResource ThumbRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image helpers:Art.Pixels="40" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ArtistLine}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                        <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Video" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                        <controls:DownloadIndicator VerticalAlignment="Center" />
                        <TextBlock MinWidth="40" TextAlignment="Right" Text="{Binding Duration, Converter={StaticResource SecondsText}}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- A numbered track row (album, playlist): #, title/artist, album, duration. -->
            <DataTemplate x:Key="TrackRowTemplate">
                <Grid Height="56" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="{StaticResource ThumbRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image helpers:Art.Pixels="40" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ArtistLine}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding AlbumTitle}" VerticalAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Grid.Column="4" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Duration, Converter={StaticResource SecondsText}}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- An album's own table: #, title over artist, duration (the cover is the header's). -->
            <DataTemplate x:Key="AlbumTrackRowTemplate">
                <Grid Height="52" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding ArtistLine}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Text="{Binding Duration, Converter={StaticResource SecondsText}}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </Grid>
            </DataTemplate>

            <!-- A collection row (album, playlist, artist in lists): thumb, title, subtitle. -->
            <DataTemplate x:Key="CardRowTemplate">
                <Grid Height="56" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="{StaticResource ThumbRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid>
                            <FontIcon Glyph="&#xE93C;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image helpers:Art.Pixels="40" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <!-- Cards: covers are the only objects, on shelves only. -->
            <DataTemplate x:Key="SquareCardTemplate">
                <StackPanel Width="160" Spacing="2">
                    <Border Width="160" Height="160" CornerRadius="{StaticResource CoverRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,6">
                        <Grid>
                            <FontIcon Glyph="&#xE93C;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image helpers:Art.Pixels="160" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="RoundCardTemplate">
                <StackPanel Width="160" Spacing="2">
                    <Border Width="160" Height="160" CornerRadius="80" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Margin="0,0,0,6">
                        <Grid>
                            <FontIcon Glyph="&#xE77B;" FontSize="28" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <Image helpers:Art.Pixels="160" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Center" TextAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitle}" HorizontalAlignment="Center" TextAlignment="Center" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
            </DataTemplate>

            <helpers:CardTemplateSelector
                x:Key="CardSelector"
                Square="{StaticResource SquareCardTemplate}"
                Round="{StaticResource RoundCardTemplate}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
