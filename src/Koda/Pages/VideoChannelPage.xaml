<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.VideoChannelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers"
    xmlns:controls="using:Koda.Controls">
    <Grid>
        <GridView
            x:Name="Cards"
            Padding="20,0,14,28"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnCardClick"
            ItemTemplate="{StaticResource VideoCardTemplate}"
            ItemContainerStyle="{StaticResource VideoCardItemStyle}"
            Visibility="Collapsed">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.Header>
                <StackPanel Spacing="16" Margin="6,16,6,12">
                    <Border x:Name="BannerFrame" Height="160" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                        <Image x:Name="Banner" helpers:Art.Pixels="1400" Stretch="UniformToFill" />
                    </Border>
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                            <Grid>
                                <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                <Image x:Name="Avatar" helpers:Art.Pixels="96" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Name="NameText" Style="{ThemeResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <TextBlock x:Name="DetailText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                        <DropDownButton x:Name="SortButton" Grid.Column="2" VerticalAlignment="Center" ToolTipService.ToolTip="Sort" AutomationProperties.Name="Sort this channel's videos" Visibility="Collapsed" />
                    </Grid>
                    <Expander x:Name="AboutExpander" Header="About" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Expanding="OnAboutExpanding" Visibility="Collapsed">
                        <StackPanel x:Name="AboutPanel" Spacing="8" />
                    </Expander>
                </StackPanel>
            </GridView.Header>
        </GridView>

        <ContentControl x:Name="LoadingView" Margin="26,16" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" IsTabStop="False" />
        <controls:ErrorState x:Name="Status" Visibility="Collapsed" />
    </Grid>
</Page>
