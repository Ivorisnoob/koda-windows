<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Koda.Pages.YouTubeSignInDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YouTube Music"
    CloseButtonText="Cancel"
    DefaultButton="Close">
    <Grid x:Name="Layout" Width="560" Height="600" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock
                Text="Sign in with your Google account. Koda never sees your password."
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <FontIcon
                    Glyph="&#xE72E;"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock
                    Text="accounts.google.com"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <Grid x:Name="Stage" Grid.Row="1">
            <WebView2 x:Name="Browser" />

            <!-- While the cookies are being proved, and when they aren't: the page is hidden
                 rather than left behind the message. -->
            <Grid
                x:Name="BusyShade"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressRing IsActive="True" Width="40" Height="40" />
                    <TextBlock
                        Text="Bringing in your YouTube Music…"
                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                        HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <Grid
                x:Name="ErrorShade"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                Visibility="Collapsed">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    MaxWidth="420">
                    <SymbolIcon Symbol="Important" HorizontalAlignment="Center" />
                    <TextBlock
                        Text="Couldn't Sign In"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="ErrorText"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button
                        Content="Try Again"
                        HorizontalAlignment="Center"
                        Click="OnTryAgainClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ContentDialog>
