<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.UserPlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls"
    xmlns:helpers="using:Koda.Helpers">
    <Grid>
        <ListView
            x:Name="Tracks"
            Padding="14,0,14,32"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnTrackClick"
            ItemContainerStyle="{StaticResource CatalogRowStyle}"
            ItemTemplate="{StaticResource AlbumTrackRowTemplate}">
            <ListView.Header>
                <StackPanel Padding="12,16,12,16" Spacing="20">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="MosaicTile" Width="232" Height="232" CornerRadius="16">
                            <Grid x:Name="Mosaic">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <FontIcon x:Name="MosaicGlyph" Grid.ColumnSpan="2" Grid.RowSpan="2" Glyph="&#xE8FD;" FontSize="74" />
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                            <TextBlock Text="Your playlist" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="HeroTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HeroDetail" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button x:Name="PlayButton" Style="{ThemeResource AccentButtonStyle}" Click="OnPlayClick" Padding="18,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ShuffleButton" Click="OnShuffleClick" Padding="18,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                        <TextBlock Text="Shuffle" />
                                    </StackPanel>
                                </Button>
                                <controls:DownloadButton x:Name="DownloadButton" />
                                <Button x:Name="MoreButton" Padding="10,7" ToolTipService.ToolTip="More" AutomationProperties.Name="More playlist actions">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- An empty playlist keeps its name, covers and actions; the way out sits under them. -->
                    <controls:ErrorState x:Name="Empty" Visibility="Collapsed" Margin="0,32,0,32" />
                </StackPanel>
            </ListView.Header>
        </ListView>
    </Grid>
</Page>
