<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls"
    xmlns:helpers="using:Koda.Helpers"
    NavigationCacheMode="Enabled">
    <Grid>
        <ScrollViewer x:Name="Scroll">
            <StackPanel Margin="26,16,26,32" Spacing="28">
                <Grid>
                    <TextBlock x:Name="Greeting" Text="Home" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    <Button
                        x:Name="RefreshButton"
                        HorizontalAlignment="Right"
                        Click="OnRefreshClick"
                        ToolTipService.ToolTip="Refresh (Ctrl+R)"
                        AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="R" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                    </Button>
                </Grid>

                <!-- The first screenful does the work (Mac sibling): Your Mix beside Quick picks. -->
                <Grid x:Name="Top" ColumnSpacing="28" RowSpacing="28" SizeChanged="OnTopSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="MixColumn" Width="380" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ContentPresenter x:Name="MixSkeleton" />
                    <Grid x:Name="MixCard" Height="300" CornerRadius="20" Visibility="Collapsed">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="MixStop0" Color="#FF5A4FCF" Offset="0" />
                                <GradientStop x:Name="MixStop1" Color="#FF8E44AD" Offset="0.55" />
                                <GradientStop x:Name="MixStop2" Color="#FF2C3E50" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Rectangle>
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0.35" />
                                    <GradientStop Color="#99000000" Offset="1" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <StackPanel Padding="24" Spacing="6" VerticalAlignment="Stretch">
                            <ItemsControl x:Name="MixCovers" Margin="0,0,0,16">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="96" Height="96" CornerRadius="12" Background="#33FFFFFF">
                                            <Image helpers:Art.Pixels="96" helpers:Art.Source="{Binding}" Stretch="UniformToFill" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="MixTitle" Text="Your Mix" Foreground="White" Style="{ThemeResource TitleTextBlockStyle}" />
                            <TextBlock x:Name="MixArtists" Foreground="#D9FFFFFF" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                                <Button Click="OnMixPlayClick" Padding="18,7" Background="White" Foreground="Black" BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnMixShuffleClick" Padding="12,7" Background="#33FFFFFF" Foreground="White" BorderThickness="0" ToolTipService.ToolTip="Shuffle">
                                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PicksPanel" Grid.Column="1" Spacing="8">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock x:Name="PicksStrapline" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="Quick picks" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                        <ContentPresenter x:Name="PicksSkeleton" />
                        <GridView
                            x:Name="Picks"
                            SelectionMode="None"
                            IsItemClickEnabled="True"
                            ItemClick="OnPickClick"
                            ScrollViewer.VerticalScrollMode="Disabled"
                            ScrollViewer.HorizontalScrollMode="Disabled"
                            ItemTemplate="{StaticResource SongRowTemplate}">
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                                    <Setter Property="Margin" Value="0,0,4,0" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid x:Name="PicksPanelGrid" Orientation="Horizontal" ItemWidth="280" ItemHeight="60" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>
                </Grid>

                <controls:ShelvesView x:Name="Shelves" />
                <ContentPresenter x:Name="SkeletonHost" />
            </StackPanel>
        </ScrollViewer>
        <controls:ErrorState x:Name="Error" Visibility="Collapsed" />
    </Grid>
</Page>
