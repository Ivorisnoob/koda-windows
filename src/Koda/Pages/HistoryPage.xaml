<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls"
    xmlns:helpers="using:Koda.Helpers">
    <Page.Resources>
        <Style x:Key="HistoryRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <DataTemplate x:Key="HistoryDayTemplate">
            <Grid Height="40" Margin="0,12,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Bottom" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                <TextBlock Grid.Column="1" Text="{Binding Detail}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HistoryPlayTemplate">
            <Grid Height="52" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" VerticalAlignment="Center" CornerRadius="{StaticResource ThumbRadius}" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Image helpers:Art.Pixels="40" helpers:Art.Source="{Binding Artwork}" Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="{Binding Title}" Style="{ThemeResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock Text="{Binding Subtitle}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <Border Padding="6,1" CornerRadius="4" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Video" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <TextBlock MinWidth="40" TextAlignment="Right" Text="{Binding Duration, Converter={StaticResource SecondsText}}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <helpers:HistoryTemplateSelector
            x:Key="HistoryRows"
            Day="{StaticResource HistoryDayTemplate}"
            Play="{StaticResource HistoryPlayTemplate}" />
    </Page.Resources>

    <Grid Padding="26,16,26,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Library" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="History" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="HeroDetail" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="PlayButton" Style="{ThemeResource AccentButtonStyle}" Click="OnPlayClick" Padding="18,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                        <TextBlock Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="ShuffleButton" Click="OnShuffleClick" Padding="12,7" ToolTipService.ToolTip="Shuffle" AutomationProperties.Name="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button x:Name="ClearButton" Visibility="Collapsed" Click="OnClearClick" Padding="14,7" ToolTipService.ToolTip="Clear your listening history">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                        <TextBlock Text="Clear" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView
            x:Name="Entries"
            Grid.Row="1"
            Margin="-12,0"
            Padding="0,0,0,28"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnEntryClick"
            ItemContainerStyle="{StaticResource HistoryRowStyle}"
            ItemTemplateSelector="{StaticResource HistoryRows}" />

        <controls:ErrorState x:Name="Empty" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Page>
