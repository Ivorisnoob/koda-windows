<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls">
    <Grid Padding="26,16,26,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2">
            <TextBlock Text="Discover" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Browse" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Search songs, albums, artists and playlists from the field above, or start from a mood. Press Ctrl+F from anywhere."
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="-26,0" Padding="26,0,26,0">
            <StackPanel Spacing="24" Padding="0,4,0,32">
                <StackPanel x:Name="RecentSection" Spacing="10" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Recent searches" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        <HyperlinkButton HorizontalAlignment="Right" Content="Clear" Click="OnClearSearchesClick" />
                    </Grid>
                    <ItemsControl x:Name="SearchChips">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal" ItemHeight="40" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Content="{Binding}"
                                    Click="OnSearchClick"
                                    CornerRadius="16"
                                    Padding="14,6"
                                    Margin="0,0,8,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Text="Moods &amp; genres" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ContentPresenter x:Name="SkeletonHost" />
                    <GridView
                        x:Name="MoodGrid"
                        Margin="-6,0"
                        Visibility="Collapsed"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnMoodClick"
                        ItemContainerStyle="{StaticResource CardGridItemStyle}">
                        <GridView.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="196" Height="84" Padding="16" CornerRadius="10" Background="{Binding Background}">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        VerticalAlignment="Center"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}"
                                        TextWrapping="Wrap"
                                        MaxLines="2"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                    <controls:ErrorState x:Name="Error" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
