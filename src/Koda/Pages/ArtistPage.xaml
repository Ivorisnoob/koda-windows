<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls"
    xmlns:helpers="using:Koda.Helpers">
    <Grid>
        <ScrollViewer x:Name="Scroll" Visibility="Collapsed">
            <StackPanel Margin="26,16,26,32" Spacing="28">
                <!-- The photo softened behind, the portrait sharp in front (Mac sibling's blurred square). -->
                <Grid Height="260" CornerRadius="20" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Image x:Name="Backdrop" helpers:Art.Soft="True" Stretch="UniformToFill" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#33000000" Offset="0" />
                                <GradientStop Color="#B3000000" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Padding="28" ColumnSpacing="24" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="148" Height="148" CornerRadius="74" BorderThickness="2" BorderBrush="#40FFFFFF" Background="#22FFFFFF">
                            <Image x:Name="Portrait" helpers:Art.Pixels="148" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                            <TextBlock x:Name="NameText" Foreground="White" Style="{ThemeResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="AudienceText" Foreground="#D9FFFFFF" Style="{ThemeResource BodyTextBlockStyle}" />
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                <Button x:Name="PlayButton" Style="{ThemeResource AccentButtonStyle}" Click="OnPlayClick" Padding="18,7">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                                        <TextBlock Text="Play" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RadioButton" Click="OnRadioClick" Padding="18,7" ToolTipService.ToolTip="Songs like this artist's, without end">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE93E;" FontSize="14" />
                                        <TextBlock Text="Radio" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SaveButton" Click="OnSaveClick" Padding="18,7">
                                    <TextBlock x:Name="SaveText" Text="Follow" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>

                <StackPanel x:Name="TopSection" Spacing="10">
                    <Grid>
                        <TextBlock Text="Top songs" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <HyperlinkButton x:Name="AllSongsLink" HorizontalAlignment="Right" Content="Show all" Click="OnAllSongsClick" />
                    </Grid>
                    <ListView
                        x:Name="TopSongs"
                        Margin="-12,0"
                        SelectionMode="None"
                        IsItemClickEnabled="True"
                        ItemClick="OnSongClick"
                        ItemContainerStyle="{StaticResource CatalogRowStyle}"
                        ItemTemplate="{StaticResource TrackRowTemplate}" />
                </StackPanel>

                <controls:ShelvesView x:Name="Releases" />

                <StackPanel x:Name="AboutSection" Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="About" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="AboutText" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="6" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentPresenter x:Name="SkeletonHost" Margin="26,16,26,0" />
        <controls:ErrorState x:Name="Error" Visibility="Collapsed" />
    </Grid>
</Page>
