<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls">
    <Grid Padding="26,16,26,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock Text="Library" Style="{ThemeResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="PlayLikedButton" Style="{ThemeResource AccentButtonStyle}" Click="OnPlayClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xF5B0;" FontSize="14" />
                        <TextBlock x:Name="PlayLabel" Text="Play" />
                    </StackPanel>
                </Button>
                <Button x:Name="ShuffleButton" Click="OnShuffleClick" ToolTipService.ToolTip="Shuffle">
                    <FontIcon Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button Click="OnImportClick" ToolTipService.ToolTip="Add likes, playlists and history from a Koda for Android backup">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="14" />
                        <TextBlock Text="Import" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <SelectorBar x:Name="Tabs" Grid.Row="1" SelectionChanged="OnTabChanged">
            <SelectorBarItem Text="Liked" Tag="liked" IsSelected="True" />
            <SelectorBarItem Text="Recently played" Tag="recent" />
            <SelectorBarItem Text="Playlists" Tag="playlists" />
            <SelectorBarItem Text="Albums" Tag="albums" />
            <SelectorBarItem Text="Artists" Tag="artists" />
        </SelectorBar>

        <ListView
            x:Name="Items"
            Grid.Row="2"
            Margin="-12,0"
            Padding="0,0,0,24"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            ItemContainerStyle="{StaticResource CatalogRowStyle}" />

        <controls:ErrorState x:Name="Empty" Grid.Row="2" Visibility="Collapsed" />

        <!-- First run: the hero action is the Android import. -->
        <StackPanel
            x:Name="Welcome"
            Grid.Row="1"
            Grid.RowSpan="2"
            MaxWidth="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10"
            Visibility="Collapsed">
            <FontIcon Glyph="&#xE8F1;" FontSize="40" HorizontalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="Your library starts here" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="Songs you like, and the albums, playlists and artists you save, gather here. Coming from Koda on your phone? Bring your likes, playlists and history along."
                HorizontalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Style="{ThemeResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                <Button Style="{ThemeResource AccentButtonStyle}" Content="Import from Koda for Android" Click="OnImportClick" />
                <Button Content="Search music" Click="OnSearchClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
