<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.MiniPlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:Koda.Helpers"
    Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="12,8,8,8" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- The cover opens the full window; there is a button for it too. -->
            <Border
                Width="64"
                Height="64"
                VerticalAlignment="Center"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                DoubleTapped="OnRestoreTapped"
                ToolTipService.ToolTip="Open Koda"
                AutomationProperties.Name="Open Koda">
                <Grid>
                    <FontIcon
                        x:Name="CoverGlyph"
                        Glyph="&#xE8D6;"
                        FontSize="18"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <Image x:Name="CoverImage" helpers:Art.Pixels="64" Stretch="UniformToFill" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" VerticalAlignment="Center" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            x:Name="TitleText"
                            Text="Nothing playing"
                            Style="{ThemeResource BodyStrongTextBlockStyle}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            AutomationProperties.Name="Track title" />
                        <TextBlock
                            x:Name="ArtistText"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            AutomationProperties.Name="Track artist" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="LikeButton"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Visibility="Collapsed"
                            Click="OnLikeClick"
                            ToolTipService.ToolTip="Add to Liked"
                            AutomationProperties.Name="Add to Liked">
                            <FontIcon x:Name="LikeIcon" Glyph="&#xEB51;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="RestoreButton"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnRestoreClick"
                            ToolTipService.ToolTip="Open Koda"
                            AutomationProperties.Name="Open Koda">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button
                            x:Name="PreviousButton"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnPreviousClick"
                            ToolTipService.ToolTip="Previous"
                            AutomationProperties.Name="Previous">
                            <FontIcon Glyph="&#xE892;" FontSize="14" />
                        </Button>
                        <Button
                            x:Name="PlayButton"
                            Width="34"
                            Height="34"
                            Padding="0"
                            CornerRadius="17"
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnPlayClick"
                            ToolTipService.ToolTip="Play"
                            AutomationProperties.Name="Play">
                            <Grid>
                                <FontIcon x:Name="PlayIcon" Glyph="&#xF5B0;" FontSize="14" />
                                <ProgressRing
                                    x:Name="LoadingRing"
                                    Width="16"
                                    Height="16"
                                    IsActive="False"
                                    Visibility="Collapsed"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="NextButton"
                            Width="30"
                            Height="30"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnNextClick"
                            ToolTipService.ToolTip="Next"
                            AutomationProperties.Name="Next">
                            <FontIcon Glyph="&#xE893;" FontSize="14" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="PositionText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Style="{ThemeResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        AutomationProperties.Name="Playback position" />
                </Grid>
            </Grid>
        </Grid>

        <ProgressBar
            x:Name="Progress"
            Grid.Row="1"
            Height="3"
            Minimum="0"
            Maximum="1"
            Value="0"
            CornerRadius="0"
            Background="Transparent"
            Foreground="{ThemeResource AccentFillColorDefaultBrush}"
            AutomationProperties.Name="Playback progress" />
    </Grid>
</Page>
