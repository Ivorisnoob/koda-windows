<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Koda.Pages.LibraryGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Koda.Controls">
    <Grid Padding="26,16,26,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Library" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HeroTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock x:Name="HeroDetail" Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Button x:Name="NewPlaylistButton" Style="{ThemeResource AccentButtonStyle}" Visibility="Collapsed" Click="OnNewPlaylistClick" Padding="16,7">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="New playlist" />
                    </StackPanel>
                </Button>
                <DropDownButton x:Name="SortButton" ToolTipService.ToolTip="Sort" AutomationProperties.Name="Sort this library" />
            </StackPanel>
        </Grid>

        <GridView
            x:Name="Cards"
            Grid.Row="1"
            Margin="-6,0"
            Padding="0,0,0,28"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnCardClick"
            ItemTemplateSelector="{StaticResource CardSelector}"
            ItemContainerStyle="{StaticResource CardGridItemStyle}" />

        <controls:ErrorState x:Name="Empty" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Page>
